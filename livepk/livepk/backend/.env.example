# ══════════════════════════════════════════════
# LivePK Backend — Environment Variables
# Copy this to .env and fill in your values
# ══════════════════════════════════════════════

# Server
PORT=5000
NODE_ENV=development

# MongoDB (use MongoDB Atlas free tier for dev)
MONGODB_URI=mongodb://localhost:27017/livepk
# Production: mongodb+srv://<user>:<pass>@cluster.mongodb.net/livepk

# JWT Secrets (use long random strings in production)
JWT_SECRET=livepk_jwt_secret_change_in_production_2024
JWT_REFRESH_SECRET=livepk_refresh_secret_change_in_production_2024
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Anthropic Claude AI
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/

# Pakistan Payment Gateways (add when ready)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

# Agora (Live Streaming)
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_certificate

# SMS / WhatsApp (Twilio or local provider)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_PHONE=

# Admin
ADMIN_EMAIL=admin@livepk.pk
ADMIN_PASSWORD=change_this_immediately
